# Backend Configuration (backend/.env)
BACKEND_PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartattend?schema=public"
JWT_SECRET="smartattend_jwt_super_secret_key_2026"
JWT_EXPIRES_IN="7d"

# Frontend Configuration (frontend/.env.local)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
AUTH_SECRET="smartattend_frontend_session_auth_secret_at_least_32_chars"
NODE_ENV="development"
