# PostgreSQL connection string (PostgreSQL >= 15)
DATABASE_URL="postgresql://user:password@localhost:5000/smartattend?schema=public"

# Server Port
PORT=5001

# Authentication
JWT_SECRET="your_jwt_secret_key_here_change_in_production"
JWT_EXPIRES_IN="7d"

# Allowed Client Origin
CLIENT_URL="http://localhost:3000"
